#!/bin/sh
# dot - back up, restore and sync ~/.config with git, without the secrets.
#
# One POSIX sh file. Runs on dash, ash/busybox, bash, ksh and zsh, on macOS
# and Linux (GNU or busybox userland). Needs only standard POSIX utilities;
# git for history and sync, gh (optional) for one-step GitHub setup.
# Every line is shorter than 80 columns, so it reads well in any terminal.
#
# Copyright (c) 2026 anamulbahar. MIT License.
# https://github.com/anamulbahar/dotfiles

# Deliberate: word splitting ($OVERLAYS, package lists: SC2086, SC2046),
# '~' in messages (SC2088), glob rules in case patterns (SC2254),
# placeholder read fields (SC2034), literal '$' in messages (SC2016),
# reading one file twice in a pipeline (SC2094), listing hook names
# (SC2012). SC2218 is a false positive for functions called from main.
# shellcheck disable=SC2086,SC2046,SC2088,SC2254,SC2034,SC2218,SC2209
# shellcheck disable=SC1091,SC2016,SC2094,SC2012

DOT_VERSION=1.3.0

if [ -n "${ZSH_VERSION:-}" ]; then emulate -R sh; fi
set -u

SELF=$0
NL='
'
TAB=$(printf '\t')

# ------------------------------------------------------------ built-in rules

# Paths that are never backed up. One glob per line.
#   no slash  -> a file or folder name at any depth        (ssh, *.pem)
#   a slash   -> a path from the top of ~/.config          (gh/hosts.yml*)
# '*' also matches '/'. Add your own in dot.ignore; '!pattern' there forces
# a path back in (the secret scanner still runs on it).
default_rules() {
    cat <<'EOF'
# secrets, keys and credentials
ssh
gnupg
.gnupg
gpg
pki
keyring
keyrings
password-store
pass
*.kdbx
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.asc
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.netrc
netrc
.git-credentials
git-credentials
credentials
*credential*
*secret*
*token*
.env
.env.*
*.env
rclone.conf
gh/hosts.yml*
hub
github-copilot
gcloud
aws
azure
doctl
.kube
kube
docker/config.json
op
1Password
Bitwarden
sops/age
*.sqlite
*.sqlite3
*.db
*.db-*
*.ldb
# history, state, caches and machine noise
.DS_Store
.localized
._*
*.icloud
Thumbs.db
desktop.ini
*history*
*.hist
.netrwhist
*viminfo*
vifminfo*
.lesshst
*.swp
*.swo
*~
undo
swap
cache
Cache
caches
.cache
CachedData
